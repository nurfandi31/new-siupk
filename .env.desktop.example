APP_NAME="SIUPK Next Desktop"
APP_ENV=desktop
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Desktop Runtime Flags
DESKTOP_MODE=true
# SQLite Database Path:
# Dikosongkan agar Electron otomatis menyimpannya di direktori userData (misal: %APPDATA%/SIUPK/database/database.sqlite).
# Jika diset eksplisit, path ini akan menimpa lokasi default userData.
# Fallback lama: database/database.sqlite di direktori instalasi aplikasi.
DESKTOP_SQLITE_PATH=
DESKTOP_APP_TITLE="SIUPK Next Desktop"

# Database Configuration (Pure SQLite Local Storage)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# Shard connection mapped to local SQLite in desktop mode
TENANT_DB_DRIVER=sqlite
TENANT_DB_DATABASE=database/database.sqlite

PLATFORM_DB_DRIVER=sqlite
PLATFORM_DB_DATABASE=database/database.sqlite

# Cache, Session, & Queue Drivers (No Redis requirement)
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=info

# Cloud Synchronization Target
DESKTOP_SYNC_SERVER_URL=https://app.SIUPK.id
DESKTOP_SYNC_API_KEY=
DESKTOP_TENANT_CODE=
DESKTOP_SYNC_TIMEOUT=30
DESKTOP_AUTO_SYNC_ON_LAUNCH=true
DESKTOP_SYNC_INTERVAL_MINUTES=15
