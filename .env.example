APP_NAME="SIUPK Next"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Docker environment ports & credentials
APP_PORT=8080
VITE_PORT=5174
FORWARD_DB_PORT=3307
FORWARD_REDIS_PORT=6379
MYSQL_ROOT_PASSWORD=root

# === SIUPK-assistant (in-process) ===
# Chat LLM (OpenAI-compatible). Required.
OPENAI_BASE_URL=https://ai-omni.enpiistudio.com/v1
OPENAI_API_KEY=
LLM_MODEL=antigravity/gemini-3.5-flash-low
LLM_TIMEOUT=120

# Embedding model (Ollama in-cluster or remote OpenAI-compatible)
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT=120
EMBEDDING_DIM=768

# Web tools for assistant
WEB_TOOLS_ENABLED=false
BRAVE_API_KEY=

# enpii/assistant RAG store (Postgres + pgvector)
RAG_DB_CONNECTION=pgsql
RAG_DB_HOST=postgres
RAG_DB_PORT=5432
RAG_DB_DATABASE=assistant
RAG_DB_USERNAME=assistant
RAG_DB_PASSWORD=assistant

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

DB_CONNECTION=platform
PLATFORM_DB_HOST=mysql
PLATFORM_DB_PORT=3306
PLATFORM_DB_DATABASE=siupk_platform
PLATFORM_DB_USERNAME=root
PLATFORM_DB_PASSWORD=

TENANT_DB_HOST=mysql
TENANT_DB_PORT=3306
TENANT_DB_DATABASE=siupk_shard_local
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=

TENANCY_SHARD_CREDENTIALS_JSON='{"local":{"username":"root","password":""},"test":{"username":"root","password":""}}'
TENANCY_ROUTE_PARAMETER=tenant
TENANCY_ALLOW_HEADER=true
TENANCY_HEADER=X-Tenant-Code
TENANCY_LOCAL_TENANT=local

REGIONAL_CODE_API_URL=https://api.kodewilayah.web.id
REGIONAL_CODE_API_TIMEOUT=10

LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=siupk
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

# WhatsApp Gateway (n8n webhook proxy)
WA_GATEWAY_BASE=
WA_GATEWAY_API_KEY=
WA_GATEWAY_TIMEOUT=15
WA_GATEWAY_INSTANCE_PREFIX=app-siupk

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateways (platform billing)
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MODE=sandbox
TRIPAY_DEFAULT_METHOD=QRIS2
TRIPAY_CALLBACK_URL=

DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_MODE=sandbox
DUITKU_DEFAULT_METHOD=SP
DUITKU_CALLBACK_URL=
DUITKU_RETURN_URL=
DUITKU_EXPIRY_PERIOD=1440

XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_MODE=sandbox
XENDIT_DEFAULT_METHOD=QRIS
XENDIT_EXPIRY_PERIOD=86400

# App asset / migration version
APP_VERSION=2026-08-05-pgvector-ollama

# Desktop / generic client update manifest
DESKTOP_LATEST_VERSION=1.0.0
DESKTOP_MIN_VERSION=1.0.0
DESKTOP_DOWNLOAD_URL=https://github.com/nurfandi31/new-siupk/releases/latest/download
DESKTOP_RELEASE_NOTES_URL=https://github.com/nurfandi31/new-siupk/releases/latest
DESKTOP_SHA512=
